# Database
DATABASE_URL=postgresql://securedocx:securedocx@localhost:5432/securedocx

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=securedocx
MINIO_SECURE=false

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# Downstream services
AI_SERVICE_URL=http://localhost:8001
BLOCKCHAIN_SERVICE_URL=http://localhost:3000

# Mock flags — flip to false as other teams come online
MOCK_AI_SERVICE=true
MOCK_BLOCKCHAIN_SERVICE=true

# Misc
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff
RATE_LIMIT_ENABLED=true